#!/bin/bash

set -eufo pipefail


yay -Sy --needed {{ $yaypack | join " " }}

elephant service enable
systemctl --user enable --now hyprpolkitagent.service


# --- greetd + noctalia-greeter -------------------------------------------
# noctalia-greeter's post-install hook creates the `greeter` user and
# /var/lib/noctalia-greeter; we only have to point greetd at it.
GREETD_CONF=/etc/greetd/config.toml
if ! grep -q 'noctalia-greeter-session' "$GREETD_CONF" 2>/dev/null; then
    [ -f "$GREETD_CONF" ] && {{ $sudo }}cp -a "$GREETD_CONF" "$GREETD_CONF.bak"
    {{ $sudo }}tee "$GREETD_CONF" >/dev/null <<'GREETD_CONFIG'
[terminal]
vt = 1

[default_session]
command = "/usr/bin/noctalia-greeter-session"
user = "greeter"
GREETD_CONFIG
fi

# Make sure no other display manager fights greetd for the VT.
for dm in sddm lightdm gdm ly; do
    if systemctl is-enabled --quiet "$dm" 2>/dev/null; then
        {{ $sudo }}systemctl disable --now "$dm"
    fi
done

{{ $sudo }}systemctl enable greetd



{{ end -}}
